ascii_logo() {
  cat <<'EOF'
   ___  _           _    _
  | _ )| |_  _ ___ | |_ (_)_ __
  | _ \| | || / -_)| ' \| | '_ \
  |___/|_|\_,_\___||_||_|_| .__/
                          |_|
EOF
}

cmd_doctor() {
  have_sf || die "sf CLI not found. Install @salesforce/cli and run: sf org login web"
  if [[ "${WANT_JSON:-0}" -eq 1 ]]; then
    compute_incident
    return $?
  fi
  local snap; take_snapshot || die "could not read org — is an org authed? try: sf org login web"
  snap="$SNAPSHOT_BLOB"

  local state env envcolor name age
  state="$(sandbox_state "$snap")"
  case "$state" in
    sandbox) env="SANDBOX"; envcolor="$YELLOW" ;;
    prod)    env="PROD";    envcolor="$RED" ;;
    *)       env="UNKNOWN"; envcolor="$GREY" ;;
  esac
  name="$(org_name "$snap")"
  age="$(human_secs "$(snap_age "$snap")")"

  compute_bar_signal "$snap"
  local faults_txt fcolor="$GREEN"
  if [[ "$SIGNAL_FAULTS_AV" == "ok" ]]; then
    if [[ "$SIGNAL_FAULTS" == "0" ]]; then
      faults_txt="none"
    else
      faults_txt="$SIGNAL_FAULTS"
      fcolor="$RED"
    fi
  else
    faults_txt="unknown ($(jq -r '.faults.reason // "FlowInterview query missed"' <<<"$snap"))"
    fcolor="$GREY"
  fi

  set_oflag
  local lastchange last_raw last_n="0"
  last_raw="$(sf_try data query "${OFLAG[@]}" -q \
    "SELECT CreatedDate, CreatedBy.Name, Section FROM SetupAuditTrail ORDER BY CreatedDate DESC LIMIT 1")" || true
  if [[ -z "$last_raw" ]] || ! jq -e '.status == 0' <<<"$last_raw" >/dev/null 2>&1; then
    lastchange="unknown ($(classify_sf_error "${last_raw:-}"))"
  else
    last_n="$(jq -r '.result.records | length' <<<"$last_raw")"
    if [[ "$last_n" == "0" ]]; then
      lastchange="none"
    else
      lastchange="$(jq -r '.result.records[0] | "\(.CreatedDate|split("T")[0]) · \(.CreatedBy.Name // "?") · \(.Section // "—")"' <<<"$last_raw")"
      lastchange="$(neutralize_plaintext "$lastchange" 200)"
    fi
  fi

  printf '%s%s%s' "$BLUE$BOLD" "$(ascii_logo)" "$RESET"
  printf '\n'
  printf '  %s%s%s   %s %s %s\n' "$BOLD" "$name" "$RESET" "$envcolor$BOLD" "$env" "$RESET"
  printf '  %sOrg Id: %s · %s · %s%s\n' "$GREY" "$(org_id "$snap")" "$(org_edition "$snap")" "$(org_pod "$snap")" "$RESET"
  printf '  %s%s%s\n' "$DIM" "$(org_user "$snap")" "$RESET"
  printf '  %ssignal %s%s%s\n\n' "$DIM" "$BOLD" "$(env_chip "$snap") · $SIGNAL_TEXT" "$RESET"

  local rows
  rows="$(headline_rows "$snap")"
  if [[ -z "$rows" ]]; then
    printf '   %sunknown (limits API missed — not 0%%)%s\n' "$GREY" "$RESET"
  else
    while IFS=$'\t' read -r used max pct lname; do
      printf '   %-30.30s %s %4d%%\n' "$lname" "$(bar_gauge "$pct" 18)" "$pct"
    done <<<"$rows"
  fi

  printf '\n'
  printf '   %sData health%s        %s\n' "$DIM" "$RESET" "$(hygiene_doctor_line)"
  printf '   %sFlow faults/paused%s  %s%s%s\n' "$DIM" "$RESET" "$fcolor$BOLD" "$faults_txt" "$RESET"
  printf '   %sLast setup change%s   %s\n' "$DIM" "$RESET" "$lastchange"
  printf '   %sCopy pack%s           %sbluechip incident | wl-copy%s\n' "$DIM" "$RESET" "$CYAN" "$RESET"
  printf '\n   %ssnapshot %s ago · bluechip %s · read-only · unofficial%s\n' \
    "$GREY" "$age" "$BLUECHIP_VERSION" "$RESET"
}

notify() { # <level> <msg>
  local level="$1" msg="$2" urg="normal"
  [[ "$level" == "critical" ]] && urg="critical"
  msg="$(neutralize_plaintext "$msg" 240)"
  level="$(neutralize_plaintext "$level" 32)"
  if notify_send_safe "Salesforce: $level" "$msg" "$urg"; then
    return 0
  fi
  printf '[%s] %s\n' "$level" "$msg" >&2
}

cmd_mcp_config() {
  local root server
  root="$(cd "$(dirname "$_bluechip_self")/.." && pwd)"
  server="$root/mcp/server.py"
  cat <<EOF
{
  "mcpServers": {
    "bluechip": {
      "command": "python3",
      "args": ["$server"],
      "env": {
        "BLUECHIP_BIN": "$root/bin/bluechip"
      }
    }
  }
}
EOF
}

cmd_help() {
  local all=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all|-a|all) all=1; shift ;;
      *) shift ;;
    esac
  done
  cat <<EOF
${BOLD}bluechip${RESET} — Salesforce admin cockpit for Omarchy  ${DIM}v$BLUECHIP_VERSION${RESET}
Default path: ${BOLD}install → sf org login web → bluechip doctor → chip${RESET}
Pipeline: ${DIM}pin → pulse → probe → pack → agent → confirm write${RESET}
See ${BOLD}docs/UX-PASS.md${RESET}. Rides your ${BOLD}sf${RESET} login — no Connected App.

${BOLD}PRIMARY${RESET}  ${DIM}(each supports --json where it returns data)${RESET}
  ${CYAN}doctor${RESET}          Org-vitals card  ${DIM}(--json = incident object)${RESET}
  ${CYAN}bar${RESET} [--all]     Waybar JSON: identity + worst signal (SBX · 62%)
  ${CYAN}pin${RESET} <alias|->    Pin an org (- clears; uses sf default)
  ${CYAN}orgs${RESET}            List sf-authed orgs (★ = pinned)
  ${CYAN}limits${RESET}          Full limit utilization table
  ${CYAN}flows${RESET}           Errored / paused Flow interviews
  ${CYAN}incident${RESET}        One pack: signal + limits + faults + NC summary + logs
  ${CYAN}context${RESET}         Markdown incident bundle (display-only)
  ${CYAN}watch${RESET} [--jsonl] Delta loop — mako / pulse on real transitions
  ${CYAN}help${RESET} [--all]    This screen; --all lists every verb

${BOLD}PIPES${RESET}
  ${DIM}bluechip context | wl-copy${RESET}
  ${DIM}bluechip incident --json | jq .signal${RESET}
  ${DIM}bluechip hygiene --json | jq .overall${RESET}

${BOLD}OPTIONS${RESET}
  -o, --org <alias>   Target this org for one command
  --refresh           Ignore cache and re-query Salesforce
  --json              Machine-readable JSON
  --yes               Sandbox-only write confirm (banned on prod / unknown)
  --no-color          Plain output

${DIM}MCP is display-only. TraceFlag start/stop require a human confirm in the CLI.${RESET}
${DIM}Unofficial · works with Salesforce® · not affiliated with Salesforce, Inc.${RESET}
EOF
  if [[ $all -eq 1 ]]; then
    cat <<EOF

${BOLD}ADVANCED${RESET}
  ${CYAN}hygiene${RESET}         Read-only data probe (measured / unknown; H1–H10)
  ${CYAN}changes${RESET}         Recent Setup Audit Trail (--json)
  ${CYAN}clipboard${RESET}       Clipboard → context pack (--pack-callout; toast on success only)
  ${CYAN}named-creds${RESET}     Named / External Credential inspector (never secrets)
  ${CYAN}callout-auth${RESET}    NC 401-class doctor (also named-creds --doctor)
  ${CYAN}types${RESET}           Apex-defined / HTTP Callout type explorer (read-only)
  ${CYAN}callout-pack${RESET}    Flow callout hand-off pack (not write authority)
  ${CYAN}preflight${RESET}       DWU / Automated Process FLS + NC principal checks
  ${CYAN}fls${RESET}             FLS / perm-set matrix --user --fields (read-only)
  ${CYAN}fls-propose${RESET}     FLS proposal diff only (does not apply)
  ${CYAN}offenders${RESET}       Limit offenders since 9am (Event Log; unknown if unavailable)
  ${CYAN}desk${RESET}            Multi-org pulse (per-org chrome)
  ${CYAN}trace${RESET}           start | status | stop — confirm-gated TraceFlag (CLI only)
  ${CYAN}logs${RESET}            Recent ApexLog [--follow] [--body]
  ${CYAN}scratchpad${RESET}      Hyprland special workspace (--boundary --dry-run is CI-safe)
  ${CYAN}refresh${RESET}         Force-refresh the cached snapshot
  ${CYAN}mcp-config${RESET}      Print Cursor/Claude MCP stdio snippet
  ${CYAN}version${RESET}
EOF
  else
    printf '\n%sMore verbs: bluechip help --all · product SoT: docs/UX-PASS.md%s\n' "$DIM" "$RESET"
  fi
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
need jq
case "$CMD" in
  bar)       cmd_bar "$@" ;;
  doctor)    cmd_doctor "$@" ;;
  orgs)      cmd_orgs "$@" ;;
  pin)       cmd_pin "$@" ;;
  limits)    cmd_limits "$@" ;;
  hygiene)   cmd_hygiene "$@" ;;
  flows)     cmd_flows "$@" ;;
  changes)   cmd_changes "$@" ;;
  incident)  cmd_incident "$@" ;;
  context)   cmd_context "$@" ;;
  named-creds|named-credentials|nc) cmd_named_creds "$@" ;;
  callout-auth|callout_auth) cmd_callout_auth "$@" ;;
  types)     cmd_types "$@" ;;
  callout-pack|callout_pack) cmd_callout_pack "$@" ;;
  preflight) cmd_preflight "$@" ;;
  fls)       cmd_fls "$@" ;;
  fls-propose|fls_propose) cmd_fls_propose "$@" ;;
  offenders) cmd_offenders "$@" ;;
  desk)      cmd_desk "$@" ;;
  clipboard) cmd_clipboard "$@" ;;
  scratchpad) cmd_scratchpad "$@" ;;
  trace)     cmd_trace "$@" ;;
  logs)      cmd_logs "$@" ;;
  watch)     cmd_watch "$@" ;;
  mcp-config|mcp) cmd_mcp_config "$@" ;;
  refresh)   FORCE_REFRESH=1; load_snapshot >/dev/null && echo "Snapshot refreshed." ;;
  version|-v|--version) echo "bluechip $BLUECHIP_VERSION" ;;
  help|-h|--help|"") cmd_help "$@" ;;
  *) die "unknown command: $CMD (try: bluechip help)" ;;
esac
