#!/usr/bin/env bash
# Hyprland / hotkey helper: clipboard → bluechip context pack.
# Does not require a desktop binding — bind it only if you want a key.
# Example (hyprland.conf):
#   bind = SUPER SHIFT, V, exec, bluechip-clipboard
set -o pipefail
bluechip=bluechip
command -v "$bluechip" >/dev/null 2>&1 || bluechip="$(dirname "$0")/bluechip"
"$bluechip" clipboard --copy "$@"
ec=$?
if command -v notify-send >/dev/null 2>&1; then
  if [[ $ec -eq 0 ]]; then
    notify-send -a "Bluechip" "Context pack" "Clipboard looked like a Flow / interview / org Id — pack copied."
  else
    notify-send -a "Bluechip" "Clipboard" "Not a Flow API name, interview Id, or org Id."
  fi
fi
exit "$ec"
